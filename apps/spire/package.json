{
    "name": "@vex-chat/spire",
    "version": "5.0.0",
    "description": "Vex server implementation in NodeJS.",
    "type": "module",
    "files": [
        "dist",
        "src",
        "LICENSE",
        "LICENSE-COMMERCIAL",
        "LICENSING.md",
        "CLA.md"
    ],
    "author": "Extra <extrahash@protonmail.com>",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vex-protocol/vex-protocol.git",
        "directory": "apps/spire"
    },
    "bugs": {
        "url": "https://github.com/vex-protocol/vex-protocol/issues"
    },
    "homepage": "https://github.com/vex-protocol/vex-protocol/tree/master/apps/spire#readme",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "rebuild:sqlite": "pnpm rebuild better-sqlite3",
        "start": "node --experimental-strip-types src/run.ts",
        "start:local": "bash scripts/start-local.sh",
        "restart": "pm2 restart spire && pm2 logs spire",
        "build": "tsc && node scripts/clean-dist-tests.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src/ scripts/stress/",
        "lint:fix": "eslint src/ scripts/stress/ --fix",
        "test": "vitest run",
        "integration:web": "node --experimental-strip-types scripts/stress/spire-stress.ts",
        "integration:cli": "node --experimental-strip-types scripts/stress/stress-cli-sweep.ts",
        "integration:repo-manifest": "node --experimental-strip-types scripts/stress/stress-repo-manifest.ts",
        "integration:docs-pack": "node --experimental-strip-types scripts/stress/stress-docs-pack.ts",
        "integration:llm-triage": "node --experimental-strip-types scripts/stress/stress-llm-triage.ts",
        "stress:web": "pnpm run integration:web",
        "stress:cli": "pnpm run integration:cli",
        "stress:repo-manifest": "pnpm run integration:repo-manifest",
        "stress:docs-pack": "pnpm run integration:docs-pack",
        "stress:llm-triage": "pnpm run integration:llm-triage",
        "gen-spk": "node scripts/gen-spk.js",
        "docs": "node ./scripts/generate-docs.js",
        "service:status-monitor": "node ./services/status-monitor/index.js",
        "service:status-monitor:clear-history": "node ./services/status-monitor/clear-history.js",
        "monitor": "node ./services/status-monitor/index.js"
    },
    "devDependencies": {
        "@changesets/cli": "2.31.1",
        "@socketsecurity/cli": "1.1.102",
        "@types/better-sqlite3": "7.6.13",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/express-serve-static-core": "5.1.1",
        "@types/jsonwebtoken": "9.0.10",
        "@types/morgan": "1.9.10",
        "@types/multer": "2.2.0",
        "@types/node": "catalog:",
        "@types/ws": "8.18.1",
        "@vex-chat/eslint-config": "workspace:*",
        "@vex-chat/libvex": "workspace:^",
        "@vitest/eslint-plugin": "1.6.24",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-n": "18.2.2",
        "eslint-plugin-perfectionist": "5.8.0",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.9.6",
        "type-coverage": "2.30.1",
        "typedoc": "0.28.20",
        "typescript": "catalog:",
        "typescript-eslint": "8.58.1",
        "vitest": "catalog:"
    },
    "typeCoverage": {
        "atLeast": 95,
        "ignoreCatch": true
    },
    "dependencies": {
        "@asyncapi/web-component": "2.6.5",
        "@scalar/express-api-reference": "0.9.7",
        "@simplewebauthn/server": "catalog:",
        "@vex-chat/crypto": "workspace:^",
        "@vex-chat/types": "workspace:^",
        "argon2": "0.44.0",
        "better-sqlite3": "11.10.0",
        "cors": "2.8.6",
        "dotenv": "17.4.1",
        "express": "5.2.1",
        "express-rate-limit": "8.3.2",
        "file-type": "22.0.1",
        "helmet": "8.1.0",
        "jsonwebtoken": "9.0.3",
        "kysely": "catalog:",
        "morgan": "1.11.0",
        "msgpackr": "catalog:",
        "multer": "2.2.0",
        "parse-duration": "2.1.6",
        "tweetnacl": "1.0.3",
        "uuid": "catalog:",
        "ws": "8.21.0",
        "zod": "catalog:"
    }
}
