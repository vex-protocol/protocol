{
    "name": "protocol",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prepare": "husky",
        "build": "pnpm -r --if-present build",
        "contracts:build": "forge build --root contracts/evm",
        "contracts:fmt": "forge fmt --check --root contracts/evm",
        "contracts:test": "forge test --root contracts/evm",
        "test": "pnpm -r --if-present test",
        "vex": "pnpm --filter @vex-chat/types --filter @vex-chat/crypto --filter @vex-chat/libvex --if-present build && node apps/vex-cli/src/vex-chat.js",
        "vex:dev": "pnpm --filter @vex-chat/types --filter @vex-chat/crypto --filter @vex-chat/libvex --if-present build && node apps/vex-cli/scripts/dev-watch.mjs",
        "vex:watch": "pnpm --filter @vex-chat/types --filter @vex-chat/crypto --filter @vex-chat/libvex --if-present build && node apps/vex-cli/scripts/dev-watch.mjs",
        "integration:cli": "bash scripts/integration-cli-with-docker.sh",
        "integration:cli:raw": "env SPIRE_STRESS_TRACE=0 pnpm --filter @vex-chat/spire run integration:cli",
        "integration:web": "env SPIRE_STRESS_TRACE=0 pnpm --filter @vex-chat/spire run integration:web",
        "integration:repo-manifest": "pnpm --filter @vex-chat/spire run integration:repo-manifest",
        "integration:docs-pack": "pnpm --filter @vex-chat/spire run integration:docs-pack",
        "integration:llm-triage": "pnpm --filter @vex-chat/spire run integration:llm-triage",
        "stress:cli": "pnpm run integration:cli",
        "stress:cli:raw": "pnpm run integration:cli:raw",
        "stress:web": "pnpm run integration:web",
        "stress:repo-manifest": "pnpm run integration:repo-manifest",
        "stress:docs-pack": "pnpm run integration:docs-pack",
        "stress:llm-triage": "pnpm run integration:llm-triage",
        "typecheck": "pnpm -r --if-present typecheck",
        "lint": "pnpm -r --if-present lint",
        "lint:fix": "pnpm -r --if-present lint:fix",
        "lint:pkg": "pnpm -r --if-present lint:pkg",
        "lint:types": "pnpm -r --if-present lint:types",
        "lint:api": "pnpm -r --if-present lint:api",
        "lint:specs": "pnpm -r --if-present lint:specs",
        "specs:check": "pnpm -r --if-present specs:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "license:check": "pnpm -r --if-present license:check",
        "version": "pnpm exec changeset version && pnpm -r --if-present run post-version"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "pnpm": {
        "overrides": {
            "@types/readable-stream": "4.0.11",
            "@types/ws": "8.18.1",
            "lodash": "^4.18.1",
            "minimatch": "^10.2.5",
            "postcss": "8.5.10",
            "rollup": "^4.60.1",
            "uuid": "14.0.0",
            "ip-address@<=10.1.0": ">=10.1.1",
            "kysely": "0.28.17",
            "brace-expansion": "5.0.6",
            "fast-uri": "3.1.2",
            "fast-xml-builder": "1.1.7",
            "protobufjs": "7.6.3",
            "dompurify": "3.4.11",
            "undici": "7.28.0",
            "js-yaml@>=4": "4.2.0",
            "qs": "6.15.2",
            "@protobufjs/utf8": "1.1.1"
        }
    },
    "devDependencies": {
        "@changesets/changelog-github": "0.5.1",
        "@changesets/cli": "2.30.0",
        "@onebeyond/license-checker": "2.2.0",
        "eslint": "10.2.0",
        "eslint-config-prettier": "10.1.8",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.8.2",
        "typescript": "catalog:",
        "typescript-eslint": "8.58.1"
    },
    "license": "AGPL-3.0-or-later"
}
